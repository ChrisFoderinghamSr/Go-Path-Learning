  "crossChecks": [
    {
      "topic": "Setup and modules",
      "url": "https://go.dev/doc/tutorial/create-module",
      "finding": "Packages and modules are distinct; dependencies and package boundaries are introduced progressively."
    },
    {
      "topic": "Language semantics",
      "url": "https://go.dev/ref/spec",
      "finding": "Zero values, slice/map behavior, switch semantics, receivers, interfaces and constraints underpin the early lessons."
    },
    {
      "topic": "Idiomatic style",
      "url": "https://go.dev/doc/effective_go",
      "finding": "Used for naming, control flow and interfaces; not treated as a complete modern guide to modules or generics."
    },
    {
      "topic": "HTTP boundaries",
      "url": "https://pkg.go.dev/net/http",
      "finding": "Headers precede writes; MaxBytesReader bounds incoming bodies; server timeouts and shutdown are explicit."
    },
    {
      "topic": "Database transactions",
      "url": "https://go.dev/doc/database/execute-transactions",
      "finding": "Every statement in an atomic unit uses sql.Tx; operations through sql.DB would run outside the transaction."
    },
    {
      "topic": "Concurrency",
      "url": "https://go.dev/ref/mem",
      "finding": "Shared mutable state requires synchronization; WaitGroup completion is distinct from mutex protection."
    },
    {
      "topic": "Fuzzing",
      "url": "https://go.dev/doc/tutorial/fuzz",
      "finding": "Exercises use stable properties and seed inputs; fuzzing complements example-based tests."
    },
    {
      "topic": "Security maintenance",
      "url": "https://go.dev/doc/security/best-practices",
      "finding": "Vulnerability scanning, updates, race checks and fuzzing provide complementary evidence."
    },
    {
      "topic": "PostgreSQL schema",
      "url": "https://www.postgresql.org/docs/current/ddl-constraints.html",
      "finding": "Constraints protect database invariants; migrations and parameter placeholders are explicitly PostgreSQL-specific."
    },
    {
      "topic": "Browser integration",
      "url": "https://developer.mozilla.org/en-US/docs/Web/API/Fetch_API/Using_Fetch",
      "finding": "fetch does not reject for all HTTP error statuses; clients check response.ok and render untrusted titles as text."
    }
  ],
